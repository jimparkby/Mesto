# Только для локального запуска (npm run once). В Edge Function эти переменные задаёт Supabase сам.
# Supabase → Project Settings → API. Service role key даёт полный доступ к базе — не публикуйте его!
SUPABASE_URL=https://tztrfetnjlvjebdrrydd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Публичные Telegram-каналы через запятую (без @). Тематический канал — имя:вид_спорта,
# например football_minsk:football (football, running, basketball, volleyball, tennis, yoga,
# cycling, workout, swimming, hockey, other)
TG_CHANNELS=sportdlyavseh_bel,olympicteamby,mst_gov_by,minskafisha

# Telegram-группы, сообщения из которых приносит бот (вебхук supabase/functions/bot): имя:вид_спорта:ветка
# (ветка 1 — общая «General»). В Supabase это секрет Edge Functions, общий для бота и ingest.
INGEST_GROUPS=volley_by:volleyball:1

# Календари городов на probeg.org через запятую (1581 — Минск); пусто — не опрашивать
PROBEG_CITY_IDS=1581

# INGEST_PAGES=2                  # страниц по ~20 постов на канал за проход
# INGEST_MAX_POST_AGE_DAYS=21     # более старые посты не разбираем
# INGEST_DEFAULT_CAPACITY=100     # если в анонсе не указано число мест
# INGEST_EVENT_STATUS=published   # hidden — всё на модерацию; неуверенно распознанные скрыты всегда
