# Без этих переменных приложение работает в демо-режиме:
# данные хранятся в localStorage, карта — OpenStreetMap через MapLibre.

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mapbox public token (pk....). Без него используется MapLibre + OSM.
VITE_MAPBOX_TOKEN=

# Ссылка на Mini App для кнопки «Поделиться», например https://t.me/SportRyadomBot/app
VITE_TG_APP_LINK=
